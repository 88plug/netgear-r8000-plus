#!/bin/sh
# Runs once on first boot after flashing (uci-defaults semantics), then
# deletes itself. Generates a real RPC secret and persists it into the
# real overlay's UCI database from then on - never hardcoded/committed
# to the repo, matching this project's existing rule for real
# credentials (see config/wireless). See config/aria2 for why this
# secret is load-bearing: aria2's own init script unconditionally binds
# its RPC port to every interface (rpc-listen-all=true, not a UCI
# option), including the WAN-facing American uplinks - an empty secret
# would leave it open to anything reachable on that shared network.
[ -z "$(uci -q get aria2.main.rpc_secret)" ] || exit 0

SECRET="$(cat /proc/sys/kernel/random/uuid 2>/dev/null | tr -d '-')"
[ -n "$SECRET" ] || exit 0

uci set aria2.main.rpc_secret="$SECRET"
uci commit aria2

exit 0
