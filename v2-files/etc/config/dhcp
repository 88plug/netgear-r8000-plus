
config dnsmasq
	option domainneeded '1'
	option boguspriv '1'
	option filterwin2k '0'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option local '/lan/'
	option domain 'lan'
	option expandhosts '1'
	option nonegcache '0'
	option cachesize '1000'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
	option nonwildcard '1'
	# localservice OFF (was '1'): confirmed live 2026-07-27 (FINDINGS.md
	# #37/#38) - real clients on the "American" 2nd-BSS (radio0/american_ap)
	# got DHCP fine but every DNS query silently vanished (kernel/conntrack
	# saw the packet arrive, dnsmasq's own query log never logged it -
	# consistent with local-service's ACL discarding it before the socket
	# layer even parses/logs it). Not needed for correctness on this
	# single-operator-owned network anyway - the firewall zones already
	# gate which interfaces can reach dnsmasq at all; local-service was
	# redundant belt-and-suspenders that broke real clients on a live
	# multi-BSS setup instead.
	option localservice '0'
	# Fallback upstream resolvers, confirmed needed live 2026-07-27
	# (FINDINGS.md #43): this router's ONLY upstream nameserver otherwise
	# comes from whatever the real "American" network's own DHCP hands
	# out (currently 192.168.1.47) via resolvfile above - a single point
	# of failure with zero redundancy. When it's unreachable (see the
	# 30-american-dns-route hotplug script for the routing-ambiguity bug
	# that caused exactly that), every FRESH DNS lookup silently fails
	# while already-cached ones keep working, masking the outage as a
	# per-client problem rather than an upstream one. dnsmasq queries all
	# configured servers, so these are pure redundancy, not a replacement
	# for the real upstream.
	list server '1.1.1.1'
	list server '8.8.8.8'
	option ednspacket_max '1232'
	option filter_aaaa '0'
	option filter_a '0'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option dhcpv4 'server'
	option dhcpv6 'server'
	option ra 'server'
	option ra_slaac '1'
	list ra_flags 'managed-config'
	list ra_flags 'other-config'

config dhcp 'wan'
	option interface 'wan'
	option ignore '1'

# Extender STA/WWAN interfaces (phy1-sta0/phy2-sta0) must never be served
# DHCP by this router's own dnsmasq - despite `nonwildcard '1'` above,
# dnsmasq's non-wildcard binding does not cover these dynamically-created
# wwan interfaces on its own, and without an explicit ignore section here
# dnsmasq answers DHCP broadcasts overheard on them directly. Confirmed
# live 2026-07-26: this router's own uplink DHCP client was racing (and
# sometimes losing to) the real upstream network's DHCP server on these
# same interfaces, and dnsmasq was also handing out bogus offers (from
# this router's own LAN pool) to unrelated third-party devices on the
# shared upstream network being repeated. Same `ignore '1'` pattern as
# the 'wan' section above - add one of these per extN_wwan/extN24_wwan
# network interface the LuCI Extender page creates.
config dhcp 'american_wwan'
	option interface 'american_wwan'
	option ignore '1'

config dhcp 'american24_wwan'
	option interface 'american24_wwan'
	option ignore '1'

config odhcpd 'odhcpd'
	option maindhcp '0'
	option leasefile '/tmp/odhcpd.leases'
	option leasetrigger '/usr/sbin/odhcpd-update'
	option loglevel '4'
	option piodir '/tmp/odhcpd-piodir'
	option hostsdir '/tmp/hosts'

config dhcp 'guest'
	option interface 'guest'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option dhcpv4 'server'

