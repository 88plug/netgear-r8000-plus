# WiFi Extender, REARCHITECTED 2026-07-26: no more relayd/raw-AP-per-target
# (etc/init.d/extender, the whole rpt_extN_ap + hostapd + relayd mechanism,
# is retired - the interfaces it created had no real firmware AP role behind
# them on this chip when a STA is already active on the same radio, and
# separately, same-SSID/cloned-or-distinct-BSSID transparent bridging is not
# how real repeaters (GL.iNet's actual shipped firmware, confirmed by
# reading their published source) solve this - they NAT/route a normal STA
# uplink out to the router's OWN existing LAN, never a second same-SSID AP).
#
# Current mechanism: each extend target is just a plain STA wifi-iface
# (config/wireless) bound to one of these interfaces, with the router's
# EXISTING `lan` zone (already what devices normally join - no new SSID)
# forwarded + NAT'd out through it via config/firewall. Auto-detects the
# target network's own channel/band the same way any OpenWrt STA does -
# wpa_supplicant negotiates it, nothing here or in etc/init.d/extender needs
# to know or set it.
#
# defaultroute: BOTH set to '0' as of 2026-07-27 (FINDINGS.md #46) - netifd
# no longer owns the default route for these interfaces at all. Real,
# verified live: parallel connections to the same destination genuinely
# split across BOTH uplinks (a weighted ECMP multipath default route +
# net.ipv4.fib_multipath_hash_policy=1, see sysctl.conf) instead of
# following just one "primary" link - confirmed via real packet-count
# deltas on both interfaces from 10 parallel connections. If netifd also
# tried to install its own single-path default route here (defaultroute
# '1' on either), it would fight/overwrite the multipath route on every
# lease renewal. etc/hotplug.d/iface/31-american-multipath-default now
# owns the default route entirely - reconstructs the weighted multipath
# route whenever either uplink's state changes, with single-path fallback
# if only one is actually up. peerdns is UNCHANGED from before this fix
# (american_wwan stays '1' - dnsmasq's resolvfile still needs the real
# network's own DNS server merged in; 30-american-dns-route's own ubus
# lookup doesn't depend on peerdns either way, but resolvfile does) -
# don't flip it, that's a separate mechanism from FINDINGS.md #43.
config interface 'american_wwan'
	option proto 'dhcp'
	option defaultroute '0'
	option peerdns '1'

config interface 'american24_wwan'
	option proto 'dhcp'
	option defaultroute '0'
	option peerdns '0'

