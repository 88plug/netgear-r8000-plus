
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid '00047d25e231d4bb4e449d4bca7f5852dfe0'
	option ula_prefix 'fd79:d2f:6706::/48'
	option packet_steering '1'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'lan4'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '192.168.1.1/24'
	option ip6assign '60'

config device
	option name 'wan'
	option macaddr 'E8:FC:AF:F9:F1:39'

config interface 'wan'
	option device 'wan'
	option proto 'dhcp'

config interface 'wan6'
	option device 'wan'
	option proto 'dhcpv6'

config device 'guest_dev'
	option name 'br-guest'
	option type 'bridge'

config interface 'guest'
	option device 'br-guest'
	option proto 'static'
	option ipaddr '192.168.2.1'
	option netmask '255.255.255.0'

# STA side of the WiFi Extender's first repeat target (see config/wireless
# ext0_sta/ext0_ap and etc/init.d/extender) - this router's own DHCP lease
# from the repeated network. Deliberately NOT a dependency for the
# repeater itself: etc/init.d/extender checks radio-level association
# (iw link), not this interface's DHCP state, before bringing up the
# AP+relay side. Any FUTURE extend target added via the LuCI Extender page
# (Network › Extender) gets its own 'extN_wwan' interface, same shape,
# created by that page - see www/luci-static/resources/view/extender.js.
#
# defaultroute/peerdns MUST both be '0' on every one of these, not just
# this one. Confirmed live 2026-07-25 (FINDINGS.md §19 addendum): without
# them, this interface's DHCP lease installs a default route at the same
# metric (0) as the real `wan` interface's, and the kernel silently
# preferred the repeated network's one - this router's own outbound
# traffic (not repeated-client traffic, which relayd handles separately at
# L2) started intermittently routing out through the third-party network
# instead of the real WAN, causing ~50% loss to real internet hosts.
# Caught by testing multi-hop connectivity (ping 8.8.8.8) after a real
# flash, not by the 1-hop gateway ping alone, which stayed clean
# throughout and would have masked this.
config interface 'ext0_wwan'
	option proto 'dhcp'
	option defaultroute '0'
	option peerdns '0'

