#!/bin/sh /etc/rc.common
# Repeats an existing WiFi network by running hostapd + relayd directly
# against a manually-created AP interface, deliberately bypassing OpenWrt's
# wifi-scripts orchestration for the AP side of an AP+STA combo.
#
# Root cause, confirmed directly on this hardware (not assumed): bringing
# up an AP-mode wifi-iface via UCI/wifi-scripts, on a radio that already has
# an active STA-mode interface, routes through brcmfmac's
# brcmf_cfg80211_request_ap_if(). patches/861 already fixes that function's
# v1/v2 version-query failure to fall through to the legacy bsscfg:ssid MBSS
# path (iface_create_ver = 0) instead of bailing with -EOPNOTSUPP - but that
# legacy MBSS path itself only supports adding AP-role interfaces alongside
# OTHER AP-role interfaces (the original patches/861 scenario: 2nd/3rd AP
# SSID on one radio). It does not support adding an AP-role interface
# alongside an active STA-role interface on this firmware - confirmed via
# dmesg: it reaches v0 (the legacy fallback) and STILL fails there
# ("Does not support interface_create (-95)").
#
# A raw `iw phy <phy> interface add <name> type __ap` for the SAME radio,
# SAME moment (STA already connected), succeeds immediately and stably -
# confirmed live, repeatedly, across reboots. This does not go through
# request_ap_if()'s MBSS-bsscfg allocation at all; it's a plain vif
# creation, which this firmware handles fine. hostapd run directly against
# that interface (not through netifd's hostapd.sh/wifi-scripts glue) works
# cleanly and does not disturb the STA interface.
#
# This is the "proper" fix given that constraint: it doesn't paper over a
# config mistake, it deliberately routes around a real, confirmed
# limitation in how OpenWrt's generic wifi-scripts drives this specific
# combination on this specific firmware, using the exact same underlying
# tools (iw, hostapd, relayd) wifi-scripts itself would use, just without
# the orchestration path that breaks here.
#
# The STA side (associating with the real upstream network being repeated)
# is NOT handled here - it stays a normal UCI wifi-iface in mode=sta,
# managed by netifd exactly as usual, because STA-only bring-up on this
# radio works perfectly through the standard path. Only the AP+relay side
# needs this script.
#
# Config comes from UCI, not hardcoded: for each `wireless` wifi-iface
# section with mode=ap AND repeater_mode='1' set, this script creates a
# matching raw AP interface on the same radio as that section's device,
# using its ssid/key/encryption, and relays it against whichever STA
# interface is already associated on that same radio. A section like this
# stays 'disabled=1' from wifi-scripts' own point of view (netifd/hostapd.sh
# must never try to bring it up itself - that's exactly the broken path) -
# this script is what actually reads and acts on it instead.

START=96
USE_PROCD=1

resolve_phy_for_device() {
	# $1 = wireless.radioN.path value (matches the PCI/platform device path)
	local devpath="/sys/devices/platform/$1" p
	for p in /sys/class/ieee80211/*; do
		[ -e "$p" ] || continue
		[ "$(readlink -f "$p/device" 2>/dev/null)" = "$(readlink -f "$devpath" 2>/dev/null)" ] && { basename "$p"; return 0; }
	done
	return 1
}

wait_for_sta_ifname() {
	# Deliberately checks radio-level association (iw link), NOT netifd's
	# DHCP-gated interface state - this router's own DHCP lease on the
	# repeated network has nothing to do with whether the repeater itself
	# can work (relayd relays OTHER devices' DHCP traffic through; it
	# doesn't need this router to have completed its own first). Confirmed
	# directly: radio association stayed solid (100+ packets flowing) even
	# while this router's own udhcpc sat retrying - waiting on the latter
	# was blocking this needlessly.
	local phy="$1" i=0 ifn
	while [ $i -lt 30 ]; do
		for ifn in /sys/class/ieee80211/"$phy"/device/net/*; do
			[ -e "$ifn" ] || continue
			ifn="$(basename "$ifn")"
			iw dev "$ifn" link 2>/dev/null | grep -q "^Connected" && { echo "$ifn"; return 0; }
		done
		sleep 1
		i=$((i + 1))
	done
	return 1
}

start_ap_relay() {
	local section="$1"
	local device ssid key encryption repeater_mode
	config_get device "$section" device
	config_get ssid "$section" ssid
	config_get key "$section" key
	config_get encryption "$section" encryption "psk2"
	config_get_bool repeater_mode "$section" repeater_mode 0

	[ "$repeater_mode" = "1" ] || return 0
	[ -n "$device" ] && [ -n "$ssid" ] || {
		echo "eufy-repeater: section $section missing device/ssid, skipping"
		return 0
	}

	local devpath
	devpath="$(uci -q get wireless."$device".path)" || {
		echo "eufy-repeater: wireless.$device.path not set, skipping $section"
		return 0
	}

	local phy
	phy="$(resolve_phy_for_device "$devpath")" || {
		echo "eufy-repeater: could not resolve phy for $device ($devpath), skipping $section"
		return 0
	}

	local sta_ifname
	sta_ifname="$(wait_for_sta_ifname "$phy")" || {
		echo "eufy-repeater: no associated STA found on $phy within 30s, skipping $section"
		return 0
	}

	# `iw dev link` has NO channel field on this iw/OpenWrt version (only
	# `freq: <MHz>`) - confirmed live, this repo does not carry an untested
	# assumption here. `iw dev info` is what actually reports the channel
	# number ("channel 6 (2437 MHz), width: ..."). Getting this wrong meant
	# the dynamic detection silently never matched, always falling through
	# to the static UCI channel below - which happened to be correct only
	# because it was manually kept in sync, not because the fallback logic
	# ever really needed testing. If the upstream AP ever changes channel,
	# the static fallback would silently go stale with no error anywhere.
	local channel
	channel="$(iw dev "$sta_ifname" info 2>/dev/null | sed -n 's/.*channel \([0-9]*\).*/\1/p')"
	[ -n "$channel" ] || channel="$(uci -q get wireless."$device".channel)"

	local ap_ifname="rpt_${section}"

	# `iw phy interface add` with no `addr` defaults the new interface to
	# the SAME MAC as the radio's existing interface (phy1-sta0 here) -
	# confirmed live 2026-07-25 (FINDINGS.md §19 v17 addendum):
	# `cat /sys/class/net/{rpt_eufy_ap,phy1-sta0}/address` both returned
	# the identical e8:fc:af:f9:f1:37. relayd's `-I` explicitly does "ARP
	# cache and host route management" per interface, keyed by MAC - two
	# of its own interfaces sharing one MAC breaks that bookkeeping
	# outright, independent of the -B/-D forwarding fix above.
	#
	# This driver silently IGNORES `addr <mac>` passed inline to
	# `iw phy ... interface add` - confirmed live: the command succeeds,
	# no error, but the resulting interface still has the default
	# (colliding) MAC. The MAC has to be set as a separate step instead:
	# `ip link set dev <ifname> down`, then `address <mac>`, then `up` -
	# confirmed live this actually takes effect and survives bringing the
	# interface back up.
	#
	# Derive a distinct MAC deterministically (XOR the locally-
	# administered bit on the STA's own MAC's first octet) instead of
	# leaving it to whatever the driver defaults to - same convention
	# this project's own main_radioN AP interfaces already use (their
	# real bssids are the router's base MAC with that same bit set,
	# confirmed against
	# `ubus call usteer local_info` output: ea:fc:af:f9:f1:39/...:37 vs
	# base e8:fc:af:f9:f1:38).
	local sta_mac ap_mac
	sta_mac="$(cat "/sys/class/net/$sta_ifname/address" 2>/dev/null)"
	if [ -n "$sta_mac" ]; then
		local first="${sta_mac%%:*}" rest="${sta_mac#*:}"
		ap_mac="$(printf '%02x' "$(( (0x$first ^ 0x02) & 0xff ))"):${rest}"
	fi

	# Raw-created interfaces bypass UCI's normal txpower plumbing entirely.
	# hostapd.conf has no tx_power directive - confirmed directly against
	# the real hostapd.conf reference shipped in this project's own SDK
	# tree, it isn't a real option there. txpower is an iw/cfg80211-level
	# setting, applied here to match the radio's own configured ceiling;
	# regulatory enforcement clamps the real RF output regardless.
	local radio_txpower
	radio_txpower="$(uci -q get wireless."$device".txpower)"

	local hw_mode="g"
	case "$(uci -q get wireless."$device".band)" in
		5g) hw_mode="a" ;;
	esac

	local hostapd_conf="/var/etc/hostapd-${section}.conf"
	mkdir -p /var/etc
	{
		echo "interface=$ap_ifname"
		echo "driver=nl80211"
		echo "ssid=$ssid"
		echo "hw_mode=$hw_mode"
		echo "channel=$channel"
		echo "ieee80211n=1"
		# hostapd's own reference config is explicit about this (its
		# ieee80211n=1 comment: "You will also need to enable WMM for
		# full HT functionality") - confirmed directly against the real
		# reference in this project's own SDK tree, not assumed. Without
		# it, association can succeed at the plain 802.11 level while
		# HT-dependent negotiation misbehaves - a real, plausible cause
		# of the fast associate/disassociate loop seen live 2026-07-25
		# (FINDINGS.md §19 v16 addendum) once a real client connected.
		echo "wmm_enabled=1"
		echo "ctrl_interface=/var/run/hostapd-${section}"
		case "$encryption" in
		none) ;;
		*)
			echo "wpa=2"
			echo "wpa_passphrase=$key"
			echo "wpa_key_mgmt=WPA-PSK"
			echo "rsn_pairwise=CCMP"
			;;
		esac
	} > "$hostapd_conf"

	# The raw interface's lifetime is tied to hostapd's own nl80211 socket -
	# confirmed live 2026-07-25 (FINDINGS.md §19 addendum): killing hostapd
	# also destroys `rpt_eufy_ap` (driver/kernel behavior, not something
	# this script controls). A bare `procd_set_param command hostapd ...`
	# respawn re-execs hostapd against an interface that no longer exists
	# after ANY hostapd exit (crash, OOM-kill, whatever) and fails forever
	# - confirmed live, it does not self-heal. Wrapping interface
	# (re)creation into the respawned command itself, instead of only
	# doing it once before the first start, means every respawn - not
	# just the initial one - restores the interface first. `iw dev del`
	# before `add` stays idempotent/safe whether or not the interface
	# currently exists.
	local recreate_iface="iw dev '$ap_ifname' del 2>/dev/null; iw phy '$phy' interface add '$ap_ifname' type __ap"
	if [ -n "$ap_mac" ]; then
		recreate_iface="$recreate_iface && ip link set dev '$ap_ifname' down && ip link set dev '$ap_ifname' address '$ap_mac' && ip link set dev '$ap_ifname' up"
	fi
	# A netifd-managed AP interface (e.g. main_radioN) always ends up
	# PROMISC+ALLMULTI - confirmed live: it's a bridge-membership side
	# effect (br-lan member ports get these set automatically by the
	# kernel's own bridging code so all traffic needed for L2 forwarding
	# reaches them). This raw-`iw`-created interface is never a br-lan
	# member (it's relayed via userspace `relayd`, not kernel bridging),
	# so it never gets them - confirmed live, flags read UP|BROADCAST|
	# MULTICAST only, missing PROMISC|ALLMULTI that a working AP has.
	# Setting them explicitly is safe and reversible (confirmed live,
	# driver accepts it cleanly - "entered promiscuous mode"/"entered
	# allmulticast mode" in dmesg) - exploratory candidate fix for the
	# real-client auth-timeout under investigation (docs/FINDINGS.md
	# §25/26), not yet confirmed to actually fix it.
	recreate_iface="$recreate_iface && ip link set dev '$ap_ifname' promisc on allmulticast on"
	recreate_iface="$recreate_iface && iw dev '$ap_ifname' set channel '$channel'"
	[ -n "$radio_txpower" ] && recreate_iface="$recreate_iface && iw dev '$ap_ifname' set txpower fixed $((radio_txpower * 100))"

	procd_open_instance "hostapd-$section"
	procd_set_param command /bin/sh -c "$recreate_iface && exec /usr/sbin/hostapd '$hostapd_conf'"
	procd_set_param respawn
	procd_close_instance

	# -B/-D are NOT on by default (confirmed against `relayd --help` on
	# this exact build, not assumed) - without them relayd relays
	# unicast/ARP traffic between the two interfaces but never forwards
	# DHCP broadcast requests across. A client associates to the raw AP
	# cleanly (WiFi/EAPOL layer is fine - this is why WMM/usteer fixes in
	# the FINDINGS.md §19 v16 addendum had no effect, that whole
	# investigation was aimed at the wrong layer) but never gets a real
	# IP from the actual Eufy DHCP server, and the client's own OS
	# "no internet" detection disconnects it within seconds - matches the
	# observed ~4s associate/disassociate pattern exactly, across every
	# client tested. Confirmed live 2026-07-25 (FINDINGS.md §19 v17
	# addendum).
	procd_open_instance "relayd-$section"
	procd_set_param command /usr/sbin/relayd -B -D -I "$ap_ifname" -I "$sta_ifname"
	procd_set_param respawn
	procd_close_instance
}

start_service() {
	. /lib/functions.sh
	config_load wireless
	config_foreach start_ap_relay wifi-iface
}

stop_service() {
	local ifn
	for ifn in /sys/class/net/rpt_*; do
		[ -e "$ifn" ] || continue
		iw dev "$(basename "$ifn")" del 2>/dev/null
	done
}
