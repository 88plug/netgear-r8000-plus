brcmfmac: implement get_antenna/set_antenna, report real chain masks

Upstream brcmfmac has never implemented the cfg80211 get_antenna/
set_antenna ops, so `iw phy <phy> info` always prints "Available
Antennas: TX 0 RX 0" on every brcmfmac radio regardless of the actual
firmware-configured chain mask - a known driver gap, confirmed by
reading cfg80211_ops in this exact tree (no .get_antenna/.set_antenna
entry at all) and confirmed identical on all 3 radios on this router
(radio0/1/2 AP and STA interfaces alike, including the two STA uplinks
already proven working end-to-end). Not evidence of a hardware fault
on any one radio - just cosmetically absent everywhere.

The firmware already exposes the real values via the "txchain"/
"rxchain" iovars - brcmf_setup_wiphybands() already reads "rxchain" at
init to compute the HT/VHT nss capability, it just never surfaces the
value to userspace. This wires both up:

- brcmf_setup_wiphybands(): also read "txchain", and set
  wiphy->available_antennas_tx/rx from the real iovar bitmasks instead
  of leaving them at the default 0 - this alone fixes the "Available
  Antennas: TX 0 RX 0" report (cfg80211's nl80211_send_wiphy() sends
  NL80211_ATTR_WIPHY_ANTENNA_AVAIL_TX/RX unconditionally from these
  fields, no op required).
- brcmf_cfg80211_get_antenna()/brcmf_cfg80211_set_antenna(): live
  get/set of the "txchain"/"rxchain" iovars, so `iw phy info` also
  reports "Configured Antennas" (cfg80211 only adds that pair when
  ops->get_antenna is non-NULL) - this is the real diagnostic value:
  it lets us read the live, per-radio configured TX/RX chain mask
  directly instead of only ever seeing it indirectly through nss
  counts baked into HT/VHT capability bits at boot.
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
@@ -2858,6 +2858,58 @@
 	return err;
 }
 
+static int
+brcmf_cfg80211_get_antenna(struct wiphy *wiphy, int radio_idx,
+			   u32 *tx_ant, u32 *rx_ant)
+{
+	struct brcmf_cfg80211_info *cfg = wiphy_to_cfg(wiphy);
+	struct net_device *ndev = cfg_to_ndev(cfg);
+	struct brcmf_if *ifp = netdev_priv(ndev);
+	struct brcmf_pub *drvr = cfg->pub;
+	u32 txchain;
+	u32 rxchain;
+	s32 err;
+
+	err = brcmf_fil_iovar_int_get(ifp, "txchain", &txchain);
+	if (err) {
+		bphy_err(drvr, "txchain error (%d)\n", err);
+		return err;
+	}
+	err = brcmf_fil_iovar_int_get(ifp, "rxchain", &rxchain);
+	if (err) {
+		bphy_err(drvr, "rxchain error (%d)\n", err);
+		return err;
+	}
+
+	*tx_ant = txchain;
+	*rx_ant = rxchain;
+	return 0;
+}
+
+static int
+brcmf_cfg80211_set_antenna(struct wiphy *wiphy, int radio_idx,
+			   u32 tx_ant, u32 rx_ant)
+{
+	struct brcmf_cfg80211_info *cfg = wiphy_to_cfg(wiphy);
+	struct net_device *ndev = cfg_to_ndev(cfg);
+	struct brcmf_if *ifp = netdev_priv(ndev);
+	struct brcmf_pub *drvr = cfg->pub;
+	s32 err;
+
+	err = brcmf_fil_iovar_int_set(ifp, "txchain", tx_ant);
+	if (err) {
+		bphy_err(drvr, "set txchain error (%d)\n", err);
+		return err;
+	}
+	err = brcmf_fil_iovar_int_set(ifp, "rxchain", rx_ant);
+	if (err) {
+		bphy_err(drvr, "set rxchain error (%d)\n", err);
+		return err;
+	}
+
+	return 0;
+}
+
 static s32
 brcmf_cfg80211_config_default_key(struct wiphy *wiphy, struct net_device *ndev,
 				  int link_id, u8 key_idx, bool unicast,
@@ -6173,6 +6225,8 @@
 	.dump_station = brcmf_cfg80211_dump_station,
 	.set_tx_power = brcmf_cfg80211_set_tx_power,
 	.get_tx_power = brcmf_cfg80211_get_tx_power,
+	.get_antenna = brcmf_cfg80211_get_antenna,
+	.set_antenna = brcmf_cfg80211_set_antenna,
 	.add_key = brcmf_cfg80211_add_key,
 	.del_key = brcmf_cfg80211_del_key,
 	.get_key = brcmf_cfg80211_get_key,
@@ -7511,6 +7565,7 @@
