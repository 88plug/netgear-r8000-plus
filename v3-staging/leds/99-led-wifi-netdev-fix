#!/bin/sh
# uci-defaults: bind the R8000 front-panel WiFi-band LEDs to the netdev
# names this build's hostapd actually creates (multi-BSS "phyN-apM"),
# instead of the legacy single-SSID "wlanN" names a stale board.d/uci
# config on this unit had been left pointing at.
#
# Builds on the v2-staging/leds investigation (DTS/GPIOs verified good,
# no kernel-level fix needed — see v2-staging/leds/notes.md). This file
# corrects the live wiring for the *current* production image, which
# creates phyN-apM interfaces rather than wlanN ones.
#
# Radio-slot <-> band mapping is hardware-fixed via GPIO (see
# v2-staging/leds/leds-and-buttons-excerpt.dts) and was independently
# confirmed live via `iw dev` channel/frequency on 192.168.1.1:
#   phy1 -> 2.4GHz (channel 1 / 2412MHz)  -> bcm53xx:white:2ghz
#   phy0 -> 5GHz upper (channel 153/5765MHz) -> bcm53xx:white:5ghz-1
#   phy2 -> 5GHz lower (channel 36 /5180MHz) -> bcm53xx:white:5ghz-2
#
# Caveat (same class as the wlanN caveat in v2-staging/notes.md): the
# GPIO<->radio-slot mapping never changes, but which kernel phy index
# (phy0/phy1/phy2) a given radio slot enumerates as is driver/probe-order
# determined. Binding to "phyN-ap0" (first/primary BSS on that phy) is
# more robust than the old wlanN scheme since it no longer depends on
# global net-device probe order, only on the phy index for that radio,
# but if a kernel/driver bump ever changes phy enumeration order,
# re-verify with:
#   for p in /sys/class/ieee80211/phy*; do
#     echo "$p -> $(iw phy $(basename $p) info | grep -m1 'Frequencies' -A2)"
#   done

. /lib/functions.sh
. /lib/functions/leds.sh

board=$(board_name)

case "$board" in
netgear,r8000)
	# WAN: already correct in board.d (link-only, off is legitimate
	# when no WAN cable has carrier) - left untouched.

	ucidef_set_led_netdev "wlan2g"  "2.4GHz" "bcm53xx:white:2ghz"   "phy1-ap0" "link tx rx"
	ucidef_set_led_netdev "wlan5g1" "5GHz-1" "bcm53xx:white:5ghz-1" "phy0-ap0" "link tx rx"
	ucidef_set_led_netdev "wlan5g2" "5GHz-2" "bcm53xx:white:5ghz-2" "phy2-ap0" "link tx rx"

	# "Wireless" front-panel LED had no consistent per-band icon; wire
	# it to the 2.4GHz AP (always-on radio, present on every R8000) so
	# it tracks general wireless-up status instead of sitting dark.
	ucidef_set_led_netdev "wireless" "Wireless" "bcm53xx:white:wireless" "phy1-ap0" "link tx rx"

	# WPS stays off/unmanaged here deliberately: it's a button-triggered
	# indicator (blinks during an active WPS pairing session via
	# hostapd's own wps_pushbutton signalling, not a steady-state
	# uci-driven trigger) - forcing default-on or heartbeat would be
	# misleading link/pairing state. Matches the existing board.d entry.
	;;
esac

exit 0
